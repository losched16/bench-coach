    {
      "slug": "cant-hit-offspeed",
      "label": "Fooled by off-speed / poor pitch recognition",
      "skill_category": "Hitting",
      "description": "Out on the front foot against changeups and slower pitches; can't recognize speed changes out of the hand.",

# BenchCoach environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored; this file must
# never contain a real value.
#
#   cp .env.example .env.local
#   npm run verify:env      # says what is still missing and what it breaks
#
# WHICH DATABASE AM I POINTED AT?
#
# The Supabase URL is the answer, and every script in this repo reads it that
# way. Production is project chdpqsumqospnaztvfqe. If NEXT_PUBLIC_SUPABASE_URL
# below is that project, you are working against real coaches' data — say so
# deliberately rather than finding out.
#
# See docs/ENVIRONMENTS.md.

# ---------------------------------------------------------------------------
# Which environment this is
# ---------------------------------------------------------------------------
# local | staging | production
#
# Declares intent. It does NOT override the URL: pointing at the production
# project while saying "staging" resolves to production, because the data does
# not care what the variable says. Leaving it unset means scripts cannot
# identify the environment and refuse to write, which is the safe default and
# an annoying one — set it.
BENCHCOACH_ENV=staging

# ---------------------------------------------------------------------------
# Required — the app will not build without these
# ---------------------------------------------------------------------------

# Which Supabase project. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser client. Public by design — it is compiled into the bundle and RLS is
# what protects the data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. BYPASSES RLS ON EVERY TABLE. Never prefix a variable holding
# this with NEXT_PUBLIC_, never paste it into a chat or an issue, and never
# commit it — a service_role key in git stays in git history after the file is
# edited, and the only remedy is rotation.
SUPABASE_SERVICE_ROLE_KEY=

# The one account that may reach /api/admin/*, including league provisioning.
# Must match the email of a real signed-in account. Unset denies everyone and
# every admin route answers 404, which reads as a bug rather than a config gap.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Optional — each one is a feature that is simply off without it
# ---------------------------------------------------------------------------

# Which account the admin PAGES render for. requireAdmin() falls back to it.
NEXT_PUBLIC_ADMIN_EMAIL=

# Absolute URLs in invitations. Without it links are relative, which is fine in
# the browser and broken in an email.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chat, practice plans, drill diagnosis. League provisioning and invitations do
# not use it, so league E2E testing works without one.
ANTHROPIC_API_KEY=

# Individual coach subscriptions. A staging environment should use TEST keys or
# none at all — league-sponsored coaches never reach checkout, so league
# testing does not need Stripe configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Authenticates the weekly check-in cron. Unset means the endpoint refuses
# everyone, which is the safe direction.
CRON_SECRET=

# Swing analysis service.
NEXT_PUBLIC_SWING_ANALYZER_URL=

# GoHighLevel marketing sync.
GHL_API_KEY=
GHL_LOCATION_ID=

# ---------------------------------------------------------------------------
# Script-only
# ---------------------------------------------------------------------------

# A Postgres role scoped to seo_pages, for scripts/seo-convert.mjs. Preferred
# over the service-role key because it can only touch one table.
# See migrations/045_seo_editor_role.sql.
SEO_DATABASE_URL=

# Authorises a script to write to production. Must NAME the project ref it is
# authorising, and only applies when the run actually resolves to that project.
# Leave it unset. Set it on the one command line that needs it, never in this
# file — a permanent override is the same as no override.
#   BENCHCOACH_ALLOW_PRODUCTION_WRITE=chdpqsumqospnaztvfqe npm run <script>
# BENCHCOACH_ALLOW_PRODUCTION_WRITE=

# Attio API key with object_configuration:read-write scope.
# Workspace settings -> Developers -> API keys -> Create key
#
# Required scopes:
#   object_configuration:read-write   creates attributes, options, statuses
#   record_permission:read            preflight counts Deal records before archiving stages
#   user_management:read              optional, resolves the Deal owner ID
#
# NEVER commit the real value. .env is gitignored.
ATTIO_API_KEY=

# Optional. Defaults to https://api.attio.com
# ATTIO_API_BASE=https://api.attio.com
